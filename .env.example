# ========================================================
# Cyprus Aydın University (CAU) — Environment Variables
# ========================================================
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env

# Server Port
PORT=3000
NODE_ENV=development

# LLM / AI Campus Assistant Credentials (Gemini or OpenAI)
# Provide your Google Gemini API key or OpenAI key for live AI answers.
# If omitted, the assistant falls back to local curated knowledge.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-3.1-flash-lite

# Database Configuration (Optional - only required for persistent SQL storage)
# DATABASE_URL=mysql://user:password@localhost:3306/cau_db

# Authentication (Optional - for administrative dashboard sessions)
# JWT_SECRET=your_jwt_secret_here
